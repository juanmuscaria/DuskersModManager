#include <windows.h>

1 ICON "DMM.ico"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1
 PRODUCTVERSION 1
 FILEFLAGSMASK VS_FF_DEBUG | VS_FF_PRERELEASE
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName",      "Duskers Mod Loader"     "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END